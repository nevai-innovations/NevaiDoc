# Postgres connection string.
# For Vercel: create a Postgres database from the "Storage" tab in your Vercel
# project (backed by Neon) and it will fill this in for you automatically,
# or create a free database at https://neon.tech and paste its connection
# string here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional: store uploads in AWS S3 (up to 100 MB per file instead of 4 MB).
# See "Connecting AWS S3" in the README. Leave unset to store files in Postgres.
# S3_BUCKET="nevaidoc-files"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""   # only for S3-compatible services (Cloudflare R2, MinIO, …)
